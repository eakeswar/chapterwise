# Azure OpenAI (Foundry v1 API) — TTS + images key (edzhub / services endpoint)
AZURE_OPENAI_API_KEY=your_key_here

# Text chat — topic extraction + Q&A
# TEXT_PROVIDER: azure | kaggle | auto  (auto = Kaggle when reachable, else Azure)
TEXT_PROVIDER=kaggle
CHAPTERWISE_LLM_TIMEOUT=600

# Azure chat — separate resource/key from TTS+images (Foundry v1, include /openai/v1)
AZURE_CHAT_API_KEY=
AZURE_CHAT_BASE_URL=
AZURE_TEXT_DEPLOYMENT=gpt-4.1-mini

# Legacy chat URL (unused when AZURE_CHAT_* is set)
AZURE_OPENAI_BASE_URL=https://edzhub-resource.openai.azure.com/openai/v1

# TTS + images share the services endpoint (must include /openai/v1)
AZURE_SERVICES_BASE_URL=https://edzhub-resource.services.ai.azure.com/openai/v1
AZURE_TTS_BASE_URL=https://edzhub-resource.services.ai.azure.com/openai/v1
AZURE_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_IMAGES_BASE_URL=https://edzhub-resource.services.ai.azure.com/openai/v1
AZURE_IMAGE_DEPLOYMENT=gpt-image-2

# Kaggle remote PDF extraction (optional — see backend/kaggle/README.md)
KAGGLE_ENABLED=false
KAGGLE_API_BASE_URL=https://xxxx.trycloudflare.com
KAGGLE_API_SECRET=generate-a-strong-secret-min-16-chars
EXTRACT_PROVIDER=auto
KAGGLE_API_TIMEOUT=120
KAGGLE_EXTRACT_TIMEOUT=900
KAGGLE_CHUNK_TIMEOUT=120
KAGGLE_UPLOAD_CHUNK_BYTES=4194304
KAGGLE_CHUNK_THRESHOLD_BYTES=10485760
KAGGLE_UPLOAD_RETRIES=3
KAGGLE_POLL_INTERVAL=5
KAGGLE_POLL_TIMEOUT=90
KAGGLE_RESULT_TIMEOUT=120

# Publish bundle to Kaggle (laptop only)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_TOKEN=KGAT_...
KAGGLE_DATASET_SLUG=chapterwise-models

# App settings
CHAPTERWISE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHAPTERWISE_TOPIC_CHUNK_PAGES=18
CHAPTERWISE_MAX_PDF_BYTES=524288000
CHAPTERWISE_EXTRACT_WORKERS=16
# Text extraction: pdfplumber (legacy) | rapidocr (batched RapidOCRPDF — faster on multi-page jobs)
CHAPTERWISE_TEXT_EXTRACTOR=rapidocr
CHAPTERWISE_RAPIDOCR_FORCE=0
CHAPTERWISE_RAPIDOCR_DPI=200
CHAPTERWISE_EXTRACT_PAGES_PER_WORKER=10
